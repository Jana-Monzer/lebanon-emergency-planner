# ---- LLM ------------------------------------------------------------------
# The code uses the OpenAI SDK. Pick ONE of the two blocks below.

# Option A: Google Gemini via its OpenAI-compatible endpoint (key from https://aistudio.google.com/apikey)
OPENAI_API_KEY=paste-your-gemini-key-here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.5-flash-lite
OPENAI_EMBEDDING_MODEL=gemini-embedding-2
# Free tier allows 5 chat requests/min; set to 0 once billing is enabled on the key
LLM_REQUESTS_PER_MINUTE=5

# Option B: OpenAI (delete OPENAI_BASE_URL, or leave it empty)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: "json_schema" (default) or "function_calling" if the endpoint rejects json_schema
# STRUCTURED_OUTPUT_METHOD=json_schema

# ---- ArcGIS feature layers (public, no token required) ----------------------
SCHOOLS_LAYER_URL=https://services3.arcgis.com/tuNLpt6Wfhd22qmO/ArcGIS/rest/services/SchoolForEmergencyPlan_Map/FeatureServer/0
HOSPITALS_LAYER_URL=https://services7.arcgis.com/WOCTeelWa8YfhXRF/ArcGIS/rest/services/Hospital_Labs/FeatureServer/0
